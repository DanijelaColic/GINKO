# ─────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────
SITE_URL=https://ginko-sobe.com
NEXT_PUBLIC_SITE_URL=https://ginko-sobe.com
NEXT_PUBLIC_SITE_NAME=Ginko Boutique Rooms & Wellness
NEXT_PUBLIC_SITE_LOCATION=Hrvatska

# ─────────────────────────────────────────────────────────────────
# Supabase  (https://supabase.com/dashboard → Project Settings → API)
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — NEVER expose to the browser; used server-side only
SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────────
# Booking confirmation (HMAC token)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────
BOOKING_VIEW_SECRET=replace-with-a-random-32-byte-hex-string

# ─────────────────────────────────────────────────────────────────
# Contact / Owner
# ─────────────────────────────────────────────────────────────────
# Javni kontakt (info@ginko-sobe.com) definiran u src/modules/booking/booking.config.ts
CONTACT_EMAIL=info@ginko-sobe.com
CONTACT_PHONE=+385959000799
# Prikaz u UI (navbar, footer)
NEXT_PUBLIC_CONTACT_PHONE=+385959000799
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=095 9000 799
# WhatsApp chat URL (opcionalno; default: wa.me iz CONTACT_PHONE)
# OWNER_WHATSAPP_URL=https://wa.me/385959000799
# NEXT_PUBLIC_OWNER_WHATSAPP_URL=https://wa.me/385959000799
OWNER_EMAIL=ginkosobe3@gmail.com
OWNER_PHONE=+385959000799

# ─────────────────────────────────────────────────────────────────
# Email (Resend) — https://resend.com/api-keys
# Production: verify domain in Resend, then set RESEND_FROM to e.g.
#   Ginko Sobe <info@ginko-sobe.com>  (not onboarding@resend.dev)
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────────────────────
# Payment (HUB3 / IBAN for booking confirmation / bank transfer)
# ─────────────────────────────────────────────────────────────────
RECIPIENT_IBAN=HR...
RECIPIENT_NAME=Ime Prezime
RECIPIENT_BIC=XXXXXXXX
RECIPIENT_BANK_NAME=Banka d.d.

# ─────────────────────────────────────────────────────────────────
# Admin panel  (see src/lib/admin-auth.ts)
# ADMIN_PASSWORD  — lozinka za prijavu na /admin/login
# ADMIN_TOKEN     — vrijednost httpOnly kolačića (random string)
# Generate:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# ADMIN_COOKIE_NAME=ginko_admin   # optional override; default: ginko_admin

# ─────────────────────────────────────────────────────────────────
# Saferpay (Worldline Hrvatska) — Payment Page
# Test: https://test.saferpay.com/api
# Live: https://www.saferpay.com/api
# Notify: https://YOUR_DOMAIN/api/webhooks/saferpay
# See WORLDLINE_CHECKLIST.md / WORLDLINE_RUNBOOK.md
# ─────────────────────────────────────────────────────────────────
SAFERPAY_CUSTOMER_ID=
SAFERPAY_TERMINAL_ID=
SAFERPAY_API_USERNAME=
SAFERPAY_API_PASSWORD=
SAFERPAY_BASE_URL=https://test.saferpay.com/api

# Legacy Worldline Online Payments / Direct — NOT used (Saferpay only).
# Kept for reference if old env still exists on Vercel; safe to delete.
# WORLDLINE_MERCHANT_ID=
# WORLDLINE_API_KEY_ID=
# WORLDLINE_API_SECRET=
# WORLDLINE_API_HOST=
# WORLDLINE_WEBHOOK_KEY_ID=
# WORLDLINE_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────────
# Chat / asistent (Faza 2–4)
# mode: widget (default) | whatsapp | disabled
# launcher: WhatsApp FAB — default OFF (Navbar već ima WhatsApp)
# LLM (Faza 4): bez OPENAI_API_KEY widget koristi keyword FAQ matching
# ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_CHAT_MODE=widget
# NEXT_PUBLIC_CHAT_LAUNCHER=0
# OPENAI_API_KEY=
# OPENAI_CHAT_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────────
# Google Analytics 4 (optional) — loads only after cookie consent
# ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX

# ─────────────────────────────────────────────────────────────────
# Google Places API — recenzije s Google Business profila
# https://console.cloud.google.com → APIs & Services → Places API (New)
# Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# GOOGLE_PLACE_ID je opcionalan — ako nije postavljen, koristi se text search po adresi
# ─────────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
