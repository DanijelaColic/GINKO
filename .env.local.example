# ─────────────────────────────────────────────────────────────────
# Site
# ─────────────────────────────────────────────────────────────────
SITE_URL=https://ginko-sobe.com
NEXT_PUBLIC_SITE_URL=https://ginko-sobe.com
NEXT_PUBLIC_SITE_NAME=Ginko Boutique Rooms & Wellness
NEXT_PUBLIC_SITE_LOCATION=Hrvatska

# ─────────────────────────────────────────────────────────────────
# Supabase  (https://supabase.com/dashboard → Project Settings → API)
# ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — NEVER expose to the browser; used server-side only
SUPABASE_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────────
# Booking confirmation (HMAC token)
# Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────
BOOKING_VIEW_SECRET=replace-with-a-random-32-byte-hex-string

# ─────────────────────────────────────────────────────────────────
# Contact / Owner
# ─────────────────────────────────────────────────────────────────
CONTACT_EMAIL=info@ginko-sobe.com
CONTACT_PHONE=+385 xx xxx xxxx
OWNER_EMAIL=ginkosobe3@gmail.com
OWNER_PHONE=+385 xx xxx xxxx

# ─────────────────────────────────────────────────────────────────
# Email (Resend) — https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM=onboarding@resend.dev

# ─────────────────────────────────────────────────────────────────
# Payment (HUB3 / IBAN for booking confirmation)
# ─────────────────────────────────────────────────────────────────
RECIPIENT_IBAN=HR...
RECIPIENT_NAME=Ime Prezime
RECIPIENT_BIC=XXXXXXXX
RECIPIENT_BANK_NAME=Banka d.d.

# ─────────────────────────────────────────────────────────────────
# Admin panel  (see src/lib/admin-auth.ts)
# ADMIN_PASSWORD  — lozinka za prijavu na /admin/login
# ADMIN_TOKEN     — vrijednost httpOnly kolačića (random string)
# Generate:  openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_TOKEN=replace-with-openssl-rand-hex-32
# ADMIN_COOKIE_NAME=ginko_admin   # optional override; default: ginko_admin

# ─────────────────────────────────────────────────────────────────
# Stripe  (https://dashboard.stripe.com/apikeys)
# Use sk_test_... / pk_test_... for development,
# sk_live_... / pk_live_... for production.
# STRIPE_WEBHOOK_SECRET: Stripe Dashboard → Webhooks → Add endpoint →
#   endpoint URL: https://your-domain/api/webhooks/stripe
#   events: payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
# ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
